---
layout: layout.njk
pagination:
  data: states
  size: 1
  alias: state
permalink: "/{{ state.slug }}/index.html"
eleventyComputed:
  title: "{{ metaTitle }}"
  description: "{{ metaDesc }}"
  stateSlug: "{{ state.slug }}"
---

{# ── Service Icon Map ──────────────────────────────────────────────────── #}
{% set serviceIcons = {
  'circuit-breaker-repair': 'ph-lightning',
  'tripping-breaker-troubleshooting': 'ph-warning-octagon',
  'main-breaker-replacement': 'ph-power',
  'electrical-panel-upgrade': 'ph-plugs-connected',
  'emergency-breaker-repair': 'ph-siren',
  'afci-gfci-breaker-service': 'ph-shield-check',
  'subpanel-installation-repair': 'ph-squares-four',
  'fuse-box-to-breaker-conversion': 'ph-arrows-clockwise',
  'dedicated-circuit-breakers': 'ph-charging-station',
  'burnt-breaker-bus-bar-repair': 'ph-thermometer-hot',
  'whole-home-surge-breakers': 'ph-shield-plus',
  'commercial-breaker-panel-service': 'ph-buildings'
} %}

{# ── Schemas ───────────────────────────────────────────────────────────── #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Circuit Breaker Repair in {{ state.name }}",
  "serviceType": "Circuit Breaker Repair & Electrical Panel Upgrades",
  "provider": { "@id": "{{ site.DOMAIN }}/#organization" },
  "url": "{{ site.DOMAIN }}/{{ state.slug }}/",
  "areaServed": {
    "@type": "State",
    "name": "{{ state.name }}"
  },
  "availableChannel": {
    "@type": "ServiceChannel",
    "servicePhone": {
      "@type": "ContactPoint",
      "telephone": "{{ site.PHONE }}",
      "contactType": "customer service",
      "areaServed": "US",
      "availableLanguage": "English"
    }
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.DOMAIN }}/" },
    { "@type": "ListItem", "position": 2, "name": "{{ state.name }}", "item": "{{ site.DOMAIN }}/{{ state.slug }}/" }
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for faq in faqs %}
    {
      "@type": "Question",
      "name": {{ faq.q | dump | safe }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ faq.a | dump | safe }} }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>

{# ── Breadcrumb ────────────────────────────────────────────────────────── #}
<div class="breadcrumb-bar">
  <div class="container">
    <div class="bc-inner">
      <i class="ph ph-house" style="font-size:13px"></i>
      <a href="/">Home</a>
      <span class="bc-sep">›</span>
      <span>{{ state.name }}</span>
    </div>
  </div>
</div>

{# ── Banner ────────────────────────────────────────────────────────────── #}
<div class="rs-banner">
  <div class="banner-bg">
    <img src="/assets/images/global_hero.webp" alt="Circuit Breaker Panel Background" loading="lazy">
  </div>
  <div class="container" style="position:relative;z-index:2">
    <div class="banner-row" style="justify-content:center">
      <div class="banner-content-col">
        <div class="banner-content banner-content-centered">
          <div class="sub-label">
            <span class="live-dot"></span> {{ state.name }} Circuit Breaker Specialists
          </div>
          <h1 class="title">{{ h1Title }}</h1>
          <p class="description">
            Connect with state-licensed local electricians across {{ state.name }} for 24/7 circuit breaker repair,
            tripping circuit troubleshooting, main disconnect swaps, AFCI/GFCI protection,
            and 200A panel upgrades — covering {{ state.cities.length }} {{ state.name }} cities and towns.
          </p>
          <div class="btn-part" style="display:flex; justify-content:center; width:100%; margin:30px auto 0;">
            <a class="readon red-btn" href="{{ site.PHONE_HREF }}">
              <i class="ph ph-phone-call" style="font-size:17px"></i>
              {{ site.PHONE }}
            </a>
          </div>
        </div>
      </div>
      <div class="banner-img-box">
        <picture>
          <source media="(max-width: 767px)" srcset="/assets/images/mobile_hero.webp">
          <img src="/assets/images/global_hero.webp" alt="Licensed electrician inspecting breaker panel in {{ state.name }}" width="800" height="600" loading="eager" decoding="async">
        </picture>
      </div>
    </div>
  </div>
</div>

{# ── Counter ───────────────────────────────────────────────────────────── #}
<div class="rs-counter">
  <div class="container">
    <div class="counter-grid">
      <div class="counter-list">
        <div class="counter-text">
          <div class="counter-icon">
            <i class="ph ph-shield-check" style="font-size:26px;color:#38bdf8"></i>
          </div>
          <div class="counter-number">
            <div class="count-row"><span class="rs-count">NEC</span><span class="prefix">Code</span></div>
            <h5 class="title">{{ state.abbr }} Compliant Repairs</h5>
          </div>
        </div>
      </div>
      <div class="counter-list">
        <div class="counter-text">
          <div class="counter-icon">
            <i class="ph ph-clock" style="font-size:26px;color:#38bdf8"></i>
          </div>
          <div class="counter-number">
            <div class="count-row"><span class="rs-count">24</span><span class="prefix">/7</span></div>
            <h5 class="title">Emergency Dispatch</h5>
          </div>
        </div>
      </div>
      <div class="counter-list">
        <div class="counter-text">
          <div class="counter-icon">
            <i class="ph ph-map-pin" style="font-size:26px;color:#38bdf8"></i>
          </div>
          <div class="counter-number">
            <div class="count-row"><span class="rs-count">{{ state.cities.length }}</span><span class="prefix">+</span></div>
            <h5 class="title">Cities in {{ state.abbr }}</h5>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{# ── Services Grid ─────────────────────────────────────────────────────── #}
<div class="rs-services">
  <div class="container">
    <h2>Circuit Breaker &amp; Panel Services in {{ state.name }}</h2>
    <div class="services-row">
      {% for svc in services %}
      <div class="services-slider">
        <div class="services-item">
          <a href="/services/{{ svc.slug }}/" class="card-link" aria-label="{{ svc.title }} in {{ state.name }}"></a>

          {% if svc.image %}
          <div class="services-card-img">
            <img src="/assets/images/{{ svc.image }}" alt="{{ svc.title }} in {{ state.name }}" loading="lazy" width="800" height="600">
          </div>
          {% endif %}
          <div class="services-icon-bar">
            <div class="svc-icon">
              <i class="ph {{ serviceIcons[svc.slug] or 'ph-lightning' }}"></i>
            </div>
          </div>
          <div class="services-content">
            <h3 class="title">
              <a href="/services/{{ svc.slug }}/">{{ svc.title }} in {{ state.name }}</a>
            </h3>
            <p class="description">
              {{ svc.description }}
              {% if loop.index0 % 3 == 0 %}
                Available 24/7 across {{ state.name }} cities.
              {% elif loop.index0 % 3 == 1 %}
                Licensed local technicians serving {{ state.name }} homeowners and businesses.
              {% else %}
                Upfront flat-rate estimates throughout {{ state.name }}.
              {% endif %}
            </p>
            <div class="services-btn">
              <a href="{{ site.PHONE_HREF }}">
                <span class="btn-text">Get Quotes</span>
                <span class="arrow-icon">
                  <i class="ph ph-arrow-right" style="font-size:12px"></i>
                </span>
              </a>
            </div>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

{# ── Why Choose ────────────────────────────────────────────────────────── #}
<div class="rs-choose">
  <div class="container">
    <div class="choose-grid">
      <div class="choose-img">
        <img src="/assets/images/circuit-breaker-repair.webp" alt="Licensed electricians in {{ state.name }} equipped for residential and commercial breaker repair" loading="lazy" width="800" height="600">
      </div>
      <div>
        <div class="sec-title4">
          <div class="sub-line"></div>
          <span class="sub-text">
            <i class="ph ph-shield-check" style="font-size:13px"></i>
            Local Electrical Standards
          </span>
          <h2>Best Circuit Breaker Experts in {{ state.name }}</h2>
          {{ whyChooseContent | safe }}
          <h3>{{ regionalRisk.title }}</h3>
          <p>{{ regionalRisk.text }}</p>
          <div style="margin-top:26px">
            <a class="readon red-btn" href="{{ site.PHONE_HREF }}">
              <i class="ph ph-phone-call" style="font-size:17px"></i>
              {{ site.PHONE }}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{# ── Who We Are ────────────────────────────────────────────────────────── #}
<div class="rs-choose" style="background:var(--gray-bg)">
  <div class="container">
    <div class="choose-grid">
      <div>
        <div class="sec-title4">
          <div class="sub-line"></div>
          <span class="sub-text">
            <i class="ph ph-info" style="font-size:13px"></i>
            Statewide Dispatch Coverage
          </span>
          <h2>{{ state.name }} Breaker &amp; Panel Pros</h2>

          {{ whoWeAreContent | safe }}

          <p style="margin-top:20px;">
            We coordinate same-day and 24/7 emergency circuit breaker repair and panel service across {{ state.name }}.
          </p>
        </div>
        <div class="about-mini">
          <div class="mini-card">
            <h4><i class="ph ph-house-line" style="font-size:14px"></i> Residential Breakers</h4>
            <p>Tripping breakers, AFCI/GFCI swaps, main breakers &amp; 200A panel upgrades in {{ state.name }}.</p>
          </div>
          <div class="mini-card">
            <h4><i class="ph ph-buildings" style="font-size:14px"></i> Commercial Panels</h4>
            <p>Fast 3-phase breaker repairs and commercial disconnects across {{ state.name }}.</p>
          </div>
        </div>
      </div>
      <div class="choose-img">
        <img src="/assets/images/emergency-breaker-repair.webp" alt="24/7 emergency circuit breaker repair specialists in {{ state.name }}" loading="lazy" width="800" height="600">
      </div>
    </div>
  </div>
</div>

{# ── Google Map ────────────────────────────────────────────────────────── #}
<div class="rs-map">
  <div class="container">
    <div class="map-frame">
      <iframe src="https://maps.google.com/maps?q={{ state.name | urlencode }}%20USA&t=&z=7&ie=UTF8&iwloc=&output=embed" width="100%" height="360" style="border:0;display:block" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Map of {{ state.name }}, USA"></iframe>
    </div>
  </div>
</div>

{# ── FAQ (JSON-LD handled cleanly at top — no duplicate microdata) ─────── #}
<div class="rs-faq">
  <div class="container">
    <h2 class="faq-inner-title">
      <i class="ph ph-chat-circle-dots" style="font-size:26px;color:var(--primary);margin-right:8px;vertical-align:middle"></i>
      Frequently Asked Questions About Breaker Repair in {{ state.name }}
    </h2>
    <div class="faq-grid">
      <div class="faq-img">
        <img src="/assets/images/burnt-breaker-inspection.webp" alt="Thermal inspection of electrical breaker panel in {{ state.name }}" loading="lazy" width="800" height="600">
      </div>
      <div class="accordion">
        {% for faq in faqs %}
        <div class="acc-item">
          <button class="acc-question" aria-expanded="{{ 'true' if loop.first else 'false' }}">
            {{ faq.q }}
            <span class="acc-icon">+</span>
          </button>
          <div class="acc-answer">
            <p>{{ faq.a }}</p>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{# ── Service Feedback ──────────────────────────────────────────────────── #}
<div class="rs-testimonial">
  <div class="container">
    <div class="sec-inner-title">
      <span class="sub-text">
        <i class="ph ph-shield-check" style="font-size:13px"></i>
        Service Feedback
      </span>
      <h2>Typical Breaker &amp; Panel Scenarios in {{ state.name }}</h2>
    </div>
    <div class="testi-grid">
      {% for t in testimonials %}
      <div class="testi-item">
        <div class="testi-stars">★★★★★</div>
        <p>"{{ t.text }}"</p>
        <div class="testi-author">
          <i class="ph ph-user-circle" style="font-size:14px;margin-right:4px"></i>
          {{ t.author }}
        </div>
        <div class="testi-loc">{{ state.name }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

{# ── Cities Grid ───────────────────────────────────────────────────────── #}
<div class="rs-addon-services">
  <div class="container">
    <h2>
      <i class="ph ph-map-trifold" style="font-size:26px;color:var(--primary);margin-right:8px;vertical-align:middle"></i>
      Find Circuit Breaker Repair in {{ state.name }} Cities
    </h2>
    <div class="addon-row">
      {% for city in state.cities %}
      <a href="/{{ state.slug }}/{{ city.slug }}/" class="addon-item" style="text-decoration:none">
        <div class="services-text">
          <div class="services-title">
            <i class="ph ph-map-pin" style="font-size:13px;color:var(--primary);flex-shrink:0"></i>
            <h3>{{ city.name }}</h3>
          </div>
          {% if city.zip or city.county %}
          <div class="location-meta">
            {% if city.zip %}<span>{{ city.zip }}</span>{% endif %}
            {% if city.county %}<span class="county"> · {{ city.county }} Co.</span>{% endif %}
          </div>
          {% endif %}
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</div>

{# ── CTA ───────────────────────────────────────────────────────────────── #}
<div class="cta-strip">
  <div class="container">
    <h2>Need Circuit Breaker Repair in {{ state.name }}? Call Now</h2>
    <p>Licensed local electricians are available 24/7 for tripping breakers, burnt panels, and emergency repairs across {{ state.name }}.</p>
    <a class="readon red-btn" href="{{ site.PHONE_HREF }}">
      <i class="ph ph-phone-call" style="font-size:18px"></i>
      {{ site.PHONE }} — Call Now
    </a>
  </div>
</div>

<script>
  localStorage.setItem('userLoc', JSON.stringify({
    stateName: "{{ state.name }}",
    stateAbbr: "{{ state.abbr }}",
    stateSlug: "{{ state.slug }}"
  }));
</script>
