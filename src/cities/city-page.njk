---
layout: layout.njk
pagination:
  data: cities
  size: 1
  alias: item
permalink: "/{{ item.state.slug }}/{{ item.city.slug }}/index.html"
eleventyComputed:
  title: "{{ metaTitle }}"
  description: "{{ metaDesc }}"
  stateSlug: "{{ item.state.slug }}"
  citySlug: "{{ item.city.slug }}"
---

{# ── Service Icon Map ──────────────────────────────────────────────────── #}
{% set serviceIcons = {
  'circuit-breaker-repair': 'ph-lightning',
  'tripping-breaker-troubleshooting': 'ph-warning-octagon',
  'main-breaker-replacement': 'ph-power',
  'electrical-panel-upgrade': 'ph-plugs-connected',
  'emergency-breaker-repair': 'ph-siren',
  'afci-gfci-breaker-service': 'ph-shield-check',
  'subpanel-installation-repair': 'ph-squares-four',
  'fuse-box-to-breaker-conversion': 'ph-arrows-clockwise',
  'dedicated-circuit-breakers': 'ph-charging-station',
  'burnt-breaker-bus-bar-repair': 'ph-thermometer-hot',
  'whole-home-surge-breakers': 'ph-shield-plus',
  'commercial-breaker-panel-service': 'ph-buildings'
} %}

{# ── Schemas (Clean, Compliant, Zero Fabricated Ratings) ───────────────── #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Circuit Breaker Repair in {{ item.city.name }}, {{ item.state.abbr }}",
  "serviceType": "Circuit Breaker Repair & Electrical Panel Service",
  "provider": { "@id": "{{ site.DOMAIN }}/#organization" },
  "description": "24/7 referral service connecting property owners in {{ item.city.name }}, {{ item.state.name }} with licensed local electricians for tripping breakers, main breaker swaps, AFCI/GFCI troubleshooting, and 200A panel upgrades.",
  "areaServed": {
    "@type": "City",
    "name": "{{ item.city.name }}",
    "containedInPlace": {
      "@type": "State",
      "name": "{{ item.state.name }}"
    }
  },
  "availableChannel": {
    "@type": "ServiceChannel",
    "servicePhone": {
      "@type": "ContactPoint",
      "telephone": "{{ site.PHONE }}",
      "contactType": "customer service",
      "areaServed": "US",
      "availableLanguage": "English"
    }
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for faq in faqs %}
    {
      "@type": "Question",
      "name": {{ faq.q | dump | safe }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ faq.a | dump | safe }} }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.DOMAIN }}/" },
    { "@type": "ListItem", "position": 2, "name": "{{ item.state.name }}", "item": "{{ site.DOMAIN }}/{{ item.state.slug }}/" },
    { "@type": "ListItem", "position": 3, "name": "{{ item.city.name }}", "item": "{{ site.DOMAIN }}/{{ item.state.slug }}/{{ item.city.slug }}/" }
  ]
}
</script>

{# ── Breadcrumb ────────────────────────────────────────────────────────── #}
<div class="breadcrumb-bar">
  <div class="container">
    <div class="bc-inner">
      <i class="ph ph-house" style="font-size:13px"></i>
      <a href="/">Home</a>
      <span class="bc-sep">›</span>
      <a href="/{{ item.state.slug }}/">{{ item.state.name }}</a>
      <span class="bc-sep">›</span>
      <span>{{ item.city.name }}, {{ item.state.abbr }}</span>
    </div>
  </div>
</div>

{# ── Banner ────────────────────────────────────────────────────────────── #}
<div class="rs-banner">
  <div class="banner-bg">
    <img src="/assets/images/global_hero.webp" alt="Circuit Breaker Panel Background" loading="lazy">
  </div>
  <div class="container" style="position:relative;z-index:2">
    <div class="banner-row" style="justify-content:center">
      <div class="banner-content-col">
        <div class="banner-content banner-content-centered">
          <div class="sub-label">
            <span class="live-dot"></span> {{ item.city.name }}, {{ item.state.abbr }} Breaker Specialists
          </div>
          <h1 class="title">{{ h1Title }}</h1>
          <p class="description">
            {{ heroDesc }}
          </p>
          <div class="btn-part" style="display:flex; justify-content:center; width:100%; margin:30px auto 0;">
            <a class="readon red-btn" href="{{ site.PHONE_HREF }}">
              <i class="ph ph-phone-call" style="font-size:17px"></i>
              {{ site.PHONE }}
            </a>
          </div>
        </div>
      </div>
      <div class="banner-img-box">
        <picture>
          <source media="(max-width: 767px)" srcset="/assets/images/mobile_hero.webp">
          <img src="/assets/images/global_hero.webp" alt="Licensed electrician inspecting breaker panel in {{ item.city.name }}, {{ item.state.abbr }}" width="800" height="600" loading="eager" decoding="async">
        </picture>
      </div>
    </div>
  </div>
</div>

{# ── Services Grid ─────────────────────────────────────────────────────── #}
<div class="rs-services">
  <div class="container">
    <h2>Circuit Breaker &amp; Panel Services in {{ item.city.name }}, {{ item.state.abbr }}</h2>
    <div class="services-row">
      {% for svc in services %}
      <div class="services-slider">
        <div class="services-item">
          <a href="/services/{{ svc.slug }}/" class="card-link" aria-label="{{ svc.title }} in {{ item.city.name }}"></a>

          {% if svc.image %}
          <div class="services-card-img">
            <img src="/assets/images/{{ svc.image }}" alt="{{ svc.title }} in {{ item.city.name }}, {{ item.state.abbr }}" loading="lazy" width="800" height="600">
          </div>
          {% endif %}
          <div class="services-icon-bar">
            <div class="svc-icon">
              <i class="ph {{ serviceIcons[svc.slug] or 'ph-lightning' }}"></i>
            </div>
          </div>
          <div class="services-content">
            <h3 class="title">
              <a href="/services/{{ svc.slug }}/">{{ svc.title }} in {{ item.city.name }}, {{ item.state.abbr }}</a>
            </h3>
            <p class="description">
              {{ svc.description }}
              {% if loop.index0 % 4 == 0 %}
                Same-day dispatch across {{ item.city.name }}, {{ item.state.abbr }}{% if item.city.zip %} ({{ item.city.zip }}){% endif %}.
              {% elif loop.index0 % 4 == 1 %}
                Licensed local service in {{ item.city.name }}{% if item.city.county %}, {{ item.city.county }} County{% endif %}.
              {% elif loop.index0 % 4 == 2 %}
                24/7 emergency availability for {{ item.city.name }}, {{ item.state.abbr }} homes and businesses.
              {% else %}
                Upfront local estimates anywhere in {{ item.city.name }}, {{ item.state.abbr }}.
              {% endif %}
            </p>
            <div class="services-btn">
              <a href="{{ site.PHONE_HREF }}">
                <span class="btn-text">Get Quotes</span>
                <span class="arrow-icon">
                  <i class="ph ph-arrow-right" style="font-size:12px"></i>
                </span>
              </a>
            </div>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

{# ── Counter ───────────────────────────────────────────────────────────── #}
<div class="rs-counter">
  <div class="container">
    <div class="counter-grid">
      <div class="counter-list">
        <div class="counter-text">
          <div class="counter-icon">
            <i class="ph ph-lightning" style="font-size:26px;color:#38bdf8"></i>
          </div>
          <div class="counter-number">
            <div class="count-row"><span class="rs-count">NEC</span><span class="prefix">2026</span></div>
            <h5 class="title">Code-Compliant Standards</h5>
          </div>
        </div>
      </div>
      <div class="counter-list">
        <div class="counter-text">
          <div class="counter-icon">
            <i class="ph ph-shield-check" style="font-size:26px;color:#38bdf8"></i>
          </div>
          <div class="counter-number">
            <div class="count-row"><span class="rs-count">UL</span><span class="prefix">OEM</span></div>
            <h5 class="title">Listed Replacement Breakers</h5>
          </div>
        </div>
      </div>
      <div class="counter-list">
        <div class="counter-text">
          <div class="counter-icon">
            <i class="ph ph-clock" style="font-size:26px;color:#38bdf8"></i>
          </div>
          <div class="counter-number">
            <div class="count-row"><span class="rs-count">24</span><span class="prefix">/7</span></div>
            <h5 class="title">Emergency Dispatch</h5>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{# ── Trust Badges ──────────────────────────────────────────────────────── #}
<div class="trust-strip">
  <div class="container">
    <div class="trust-grid">
      <div class="trust-item">
        <i class="ph ph-certificate" style="font-size:28px;color:var(--accent)"></i>
        <div>
          <strong>Licensed &amp; Insured</strong>
          <span>Contractors licensed for {{ item.state.name }} work</span>
        </div>
      </div>
      <div class="trust-item">
        <i class="ph ph-clock-countdown" style="font-size:28px;color:var(--accent)"></i>
        <div>
          <strong>Fast Local Dispatch</strong>
          <span>Serving {{ item.city.name }} &amp; {{ item.city.county or item.state.name }}</span>
        </div>
      </div>
      <div class="trust-item">
        <i class="ph ph-tag" style="font-size:28px;color:var(--accent)"></i>
        <div>
          <strong>Upfront Flat Quotes</strong>
          <span>Written estimate before repair work begins</span>
        </div>
      </div>
      <div class="trust-item">
        <i class="ph ph-shield-check" style="font-size:28px;color:var(--accent)"></i>
        <div>
          <strong>Thermal &amp; Load Testing</strong>
          <span>Amp-draw checks &amp; OEM torque specs</span>
        </div>
      </div>
    </div>
  </div>
</div>

{# ── Why Choose Us + Local Grid Profile ────────────────────────────────── #}
<div class="rs-choose" style="background:var(--gray-bg)">
  <div class="container">
    <div class="choose-grid">
      <div>
        <div class="sec-title4">
          <div class="sub-line"></div>
          <span class="sub-text">
            <i class="ph ph-shield-check" style="font-size:13px"></i>
            Local Electrical Expertise
          </span>
          <h2>Circuit Breaker Diagnostics in {{ item.city.name }}, {{ item.state.abbr }}</h2>
          {{ whyChooseContent | safe }}
          <h3>{{ regionalRisk.title }}</h3>
          <p>{{ regionalRisk.text }}</p>

          {% if item.city.county %}
          <div style="margin-top:15px;padding:12px 14px;background:rgba(37,99,235,0.08);border-left:3px solid var(--primary);border-radius:6px">
            <strong><i class="ph ph-warning-circle" style="margin-right:6px;color:var(--primary)"></i>Electrical Safety Notice:</strong> If you see sparks, smoke, or smell burning plastic from your breaker box in <strong>{{ item.city.county }} County</strong>, stay clear of the panel, call 911 if active fire is present, and contact our 24/7 dispatch line.
          </div>
          {% endif %}
        </div>

        {% if item.city.zipCodes and item.city.zipCodes.length > 0 %}
        <div class="zip-section">
          <h3><i class="ph ph-map-pin-line" style="font-size:15px"></i> Service ZIP Codes Covered in {{ item.city.name }}</h3>
          <div class="zip-wrap">
            {% for z in item.city.zipCodes %}
            <span class="zip-pill">{{ z }}</span>
            {% endfor %}
          </div>
        </div>
        {% elif item.city.zip %}
        <div class="zip-section">
          <h3><i class="ph ph-map-pin-line" style="font-size:15px"></i> Service ZIP Code Covered</h3>
          <div class="zip-wrap">
            <span class="zip-pill">{{ item.city.zip }}</span>
          </div>
        </div>
        {% endif %}

        <div style="margin-top:26px">
          <a class="readon red-btn" href="{{ site.PHONE_HREF }}">
            <i class="ph ph-phone-call" style="font-size:17px"></i>
            {{ site.PHONE }}
          </a>
        </div>
      </div>
      <div class="choose-img">
        <img src="/assets/images/circuit-breaker-repair.webp" alt="Licensed electrician repairing circuit breaker box in {{ item.city.name }}, {{ item.state.name }}" loading="lazy" width="800" height="600">
      </div>
    </div>
  </div>
</div>

{# ── Who We Are + Local Diagnostic Reference ───────────────────────────── #}
<div class="rs-choose">
  <div class="container">
    <div class="choose-grid">
      <div class="choose-img">
        <img src="/assets/images/electrical-panel-upgrade.webp" alt="Upgraded 200A circuit breaker panel installation in {{ item.city.name }}, {{ item.state.abbr }}" loading="lazy" width="800" height="600">
      </div>
      <div>
        <div class="sec-title4">
          <div class="sub-line"></div>
          <span class="sub-text">
            <i class="ph ph-info" style="font-size:13px"></i>
            Local Service Coverage
          </span>
          <h2>{{ item.city.name }}, {{ item.state.abbr }} Breaker &amp; Panel Pros</h2>

          {{ whoWeAreContent | safe }}

          <p>
            Service coordination covers {{ item.city.name }}{% if item.city.county %}, {{ item.city.county }} County{% endif %}, and surrounding
            {{ item.state.name }} neighborhoods for both residential breaker boxes and commercial switchgear.
          </p>
        </div>

        <div class="about-mini">
          <div class="mini-card">
            <h4><i class="ph ph-house-line" style="font-size:14px"></i> Residential Panels</h4>
            <p>Tripping circuits, AFCI/GFCI swaps, main breakers &amp; 200A heavy-ups in {{ item.city.name }}.</p>
          </div>
          <div class="mini-card">
            <h4><i class="ph ph-buildings" style="font-size:14px"></i> Commercial Switchgear</h4>
            <p>3-phase bolt-on breakers and commercial disconnect repairs in {{ item.city.name }}, {{ item.state.abbr }}.</p>
          </div>
        </div>

        <div class="local-diag-box">
          <h3><i class="ph ph-wrench" style="color:var(--primary)"></i> Breaker Symptom Quick Check &amp; Local Service in {{ item.city.name }}</h3>
          <ul>
            {% for sym in citySymptoms %}
            <li>
              <strong>{{ sym.symptom }}:</strong> {{ sym.cause }} — <em>{{ sym.action }}</em>
            </li>
            {% endfor %}
          </ul>
          <p style="font-size:13.5px;color:var(--text-body);line-height:1.65;margin:10px 0;">
            {{ localCoverageCopy }}
          </p>
          <p class="diag-brands-line">
            <strong>Supported Panels:</strong>
            {% for b in cityBrands %}{{ b.name }}{% if not loop.last %} · {% endif %}{% endfor %}
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

{# ── How It Works ──────────────────────────────────────────────────────── #}
<div class="rs-process">
  <div class="container">
    <div class="sec-center">
      <span class="sub-label"><i class="ph ph-list-numbers" style="font-size:12px"></i> How It Works</span>
      <h2>Getting Circuit Breaker Help in {{ item.city.name }}, {{ item.state.abbr }}</h2>
      <p class="sec-desc">Three clear steps from dispatch call to safe, NEC-compliant power restoration.</p>
    </div>
    <div class="process-grid">
      <div class="process-step">
        <div class="step-num">01</div>
        <div class="step-icon"><i class="ph ph-phone-call" style="font-size:32px;color:var(--primary)"></i></div>
        <h3>Call 24/7 US Dispatch</h3>
        <p>Call <a href="{{ site.PHONE_HREF }}" style="color:var(--primary);font-weight:700">{{ site.PHONE }}</a> to share your breaker issue and {{ item.city.name }} ZIP code so an available local electrician can be matched.</p>
      </div>
      <div class="process-step">
        <div class="step-num">02</div>
        <div class="step-icon"><i class="ph ph-magnifying-glass" style="font-size:32px;color:var(--primary)"></i></div>
        <h3>Diagnostic &amp; Written Quote</h3>
        <p>Your electrician tests amp draw, bus bar condition, and branch wiring at your {{ item.city.name }} property and reviews an upfront flat-rate quote.</p>
      </div>
      <div class="process-step">
        <div class="step-num">03</div>
        <div class="step-icon"><i class="ph ph-wrench" style="font-size:32px;color:var(--primary)"></i></div>
        <h3>Code-Compliant Repair</h3>
        <p>Defective breakers are replaced with UL-listed OEM units, terminals are torqued to manufacturer specs, and safe load voltage is verified.</p>
      </div>
    </div>
  </div>
</div>

{# ── Google Map ────────────────────────────────────────────────────────── #}
<div class="rs-map">
  <div class="container">
    <div class="map-frame">
      <iframe src="https://maps.google.com/maps?q={{ item.city.name | urlencode }},%20{{ item.state.abbr | urlencode }}%20USA&t=&z=11&ie=UTF8&iwloc=&output=embed" width="100%" height="360" style="border:0;display:block" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Service Area Map of {{ item.city.name }}, {{ item.state.abbr }}"></iframe>
    </div>
  </div>
</div>

{# ── FAQ (JSON-LD handled cleanly in head/top — no duplicate microdata) ── #}
<div class="rs-faq">
  <div class="container">
    <h2 class="faq-inner-title">
      <i class="ph ph-chat-circle-dots" style="font-size:26px;color:var(--primary);margin-right:8px;vertical-align:middle"></i>
      Frequently Asked Questions About Breaker Repair in {{ item.city.name }}, {{ item.state.abbr }}
    </h2>
    <div class="faq-grid">
      <div class="faq-img">
        <img src="/assets/images/burnt-breaker-inspection.webp" alt="Thermal breaker panel inspection in {{ item.city.name }}, {{ item.state.abbr }}" loading="lazy" width="800" height="600">
      </div>
      <div class="accordion">
        {% for faq in faqs %}
        <div class="acc-item">
          <button class="acc-question" aria-expanded="{{ 'true' if loop.first else 'false' }}">
            {{ faq.q }}
            <span class="acc-icon">+</span>
          </button>
          <div class="acc-answer">
            <p>{{ faq.a }}</p>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{# ── Customer Service Highlights ───────────────────────────────────────── #}
<div class="rs-testimonial">
  <div class="container">
    <div class="sec-inner-title">
      <span class="sub-text">
        <i class="ph ph-shield-check" style="font-size:13px"></i>
        Service Feedback
      </span>
      <h2>Typical Breaker &amp; Panel Scenarios in {{ item.city.name }}</h2>
    </div>
    <div class="testi-grid">
      {% for t in testimonials %}
      <div class="testi-item">
        <div class="testi-stars">★★★★★</div>
        <p>"{{ t.text }}"</p>
        <div class="testi-author">
          <i class="ph ph-user-circle" style="font-size:14px;margin-right:4px"></i>
          {{ t.author }}
        </div>
        <div class="testi-loc">{{ item.city.name }}, {{ item.state.abbr }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

{# ── Nearby Cities (Same-County Priority + Circular Neighbor Window) ───── #}
{% if nearbyCities and nearbyCities.length > 0 %}
<div class="nearby-section">
  <div class="container">
    <a href="/{{ item.state.slug }}/" style="text-decoration:none">
      <h3>
        <i class="ph ph-map-trifold" style="font-size:18px;color:var(--primary)"></i>
        Nearby Circuit Breaker Repair Locations in {{ item.state.name }}
      </h3>
    </a>
    <div class="nearby-links">
      {% for nc in nearbyCities %}
      <a href="/{{ item.state.slug }}/{{ nc.slug }}/" class="nearby-link">{{ nc.name }}, {{ item.state.abbr }}</a>
      {% endfor %}
    </div>
  </div>
</div>
{% endif %}

{# ── CTA ───────────────────────────────────────────────────────────────── #}
<div class="cta-strip">
  <div class="container">
    <h2>{{ ctaCopy.title }}</h2>
    <p>{{ ctaCopy.desc }}</p>
    <a class="readon red-btn" href="{{ site.PHONE_HREF }}">
      <i class="ph ph-phone-call" style="font-size:18px"></i>
      {{ site.PHONE }} — Call Now
    </a>
  </div>
</div>

<script>
  localStorage.setItem('userLoc', JSON.stringify({
    stateName: "{{ item.state.name }}",
    stateAbbr: "{{ item.state.abbr }}",
    stateSlug: "{{ item.state.slug }}",
    cityName: "{{ item.city.name }}",
    citySlug: "{{ item.city.slug }}"
  }));
</script>
