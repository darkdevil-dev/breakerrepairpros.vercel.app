---
layout: layout.njk
title: "Circuit Breaker Repair & Panel Upgrade Services | Breaker Repair Pros"
description: "Explore our specialized circuit breaker repair services. Connect with licensed local electricians for tripping breaker troubleshooting, main breaker swaps, AFCI/GFCI protection, and 200A panel upgrades."
permalink: "services/index.html"
---

{# ── Schemas ───────────────────────────────────────────────────────────── #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "{{ site.BRAND }} - Services",
  "url": "{{ site.DOMAIN }}/services/",
  "about": {
    "@type": "Service",
    "serviceType": "Circuit Breaker Repair & Electrical Panel Upgrades",
    "provider": { "@id": "{{ site.DOMAIN }}/#organization" },
    "areaServed": { "@type": "Country", "name": "United States" }
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.DOMAIN }}/" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "{{ site.DOMAIN }}/services/" }
  ]
}
</script>

{# ── Service Icon Map ──────────────────────────────────────────────────── #}
{% set serviceIcons = {
  'circuit-breaker-repair': 'ph-lightning',
  'tripping-breaker-troubleshooting': 'ph-warning-octagon',
  'main-breaker-replacement': 'ph-power',
  'electrical-panel-upgrade': 'ph-plugs-connected',
  'emergency-breaker-repair': 'ph-siren',
  'afci-gfci-breaker-service': 'ph-shield-check',
  'subpanel-installation-repair': 'ph-squares-four',
  'fuse-box-to-breaker-conversion': 'ph-arrows-clockwise',
  'dedicated-circuit-breakers': 'ph-charging-station',
  'burnt-breaker-bus-bar-repair': 'ph-thermometer-hot',
  'whole-home-surge-breakers': 'ph-shield-plus',
  'commercial-breaker-panel-service': 'ph-buildings'
} %}

{# ── Breadcrumb ────────────────────────────────────────────────────────── #}
<div class="breadcrumb-bar">
  <div class="container">
    <div class="bc-inner" id="svcBreadcrumb">
      <i class="ph ph-house" style="font-size:13px"></i>
      <a href="/">Home</a>
      <span class="bc-sep">›</span>
      <span>Our Services</span>
    </div>
  </div>
</div>

{# ── Banner ────────────────────────────────────────────────────────────── #}
<div class="rs-banner">
  <div class="banner-bg">
    <img src="/assets/images/global_hero.webp" alt="Circuit Breaker Panel Background" loading="lazy">
  </div>
  <div class="container" style="position:relative;z-index:2">
    <div class="banner-row" style="justify-content:center">
      <div class="banner-content-col">
        <div class="banner-content banner-content-centered">
          <div class="sub-label">
            <span class="live-dot"></span> Professional Breaker Services
          </div>
          <h1 class="title">
            Circuit Breaker &amp; Panel Services <span id="svcLocationSpan">Nationwide</span>
          </h1>
          <p class="description" id="svcBannerDesc">
            Connect with licensed independent electricians 24/7 for tripping breaker troubleshooting, OEM circuit breaker replacement, main disconnect repairs, AFCI/GFCI protection, and 200A panel upgrades.
          </p>
          <div class="btn-part" style="display:flex; justify-content:center; width:100%; margin:30px auto 0;">
            <a class="readon red-btn" href="{{ site.PHONE_HREF }}">
              <i class="ph ph-phone-call" style="font-size:17px"></i>
              {{ site.PHONE }}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{# ── Services Grid ─────────────────────────────────────────────────────── #}
<div class="rs-services">
  <div class="container">
    <h2>Specialized Circuit Breaker &amp; Panel Solutions <span class="js-loc-h2"></span></h2>
    <div class="services-row">
      {% for svc in services %}
      <div class="services-slider">
        <div class="services-item">
          <a href="/services/{{ svc.slug }}/" class="card-link js-svc-link" data-slug="{{ svc.slug }}" aria-label="{{ svc.title }}"></a>

          {% if svc.image %}
          <div class="services-card-img">
            <img src="/assets/images/{{ svc.image }}" alt="{{ svc.title }}" loading="lazy">
          </div>
          {% endif %}
          <div class="services-icon-bar">
            <div class="svc-icon">
              <i class="ph {{ serviceIcons[svc.slug] or 'ph-lightning' }}"></i>
            </div>
          </div>
          <div class="services-content">
            <h3 class="title">
              <a href="/services/{{ svc.slug }}/" class="js-svc-link" data-slug="{{ svc.slug }}">
                {{ svc.title }}
              </a>
            </h3>
            <p class="description">
              {{ svc.description }}
            </p>
            <div class="services-btn">
              <a href="/services/{{ svc.slug }}/">
                <span class="btn-text">View Service Details</span>
                <span class="arrow-icon">
                  <i class="ph ph-arrow-right" style="font-size:12px"></i>
                </span>
              </a>
            </div>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

{# ── CTA Strip ─────────────────────────────────────────────────────────── #}
<div class="cta-strip">
  <div class="container">
    <h2 id="svcCtaH2">Need Circuit Breaker Diagnostics or Repair?</h2>
    <p>Our licensed independent electrician network is available 24/7 for prompt scheduling and emergency service.</p>
    <a class="readon red-btn" href="{{ site.PHONE_HREF }}">
      <i class="ph ph-phone-call" style="font-size:18px"></i>
      {{ site.PHONE }} — Call Now
    </a>
  </div>
</div>

{# ── Client-Side Location Detection ───────────────────────────────────── #}
<script>
(function () {
  var userLocStr = localStorage.getItem('userLoc');
  if (!userLocStr) return;

  var loc;
  try {
    loc = JSON.parse(userLocStr);
  } catch(e) {
    return;
  }

  var locText = 'in ' + loc.stateName;
  var locLower = locText.toLowerCase();

  if (loc.cityName) {
    locText = 'in ' + loc.cityName + ', ' + loc.stateAbbr;
    locLower = locText.toLowerCase();
  }

  var locSpan = document.getElementById('svcLocationSpan');
  if (locSpan) locSpan.textContent = locText;

  var desc = document.getElementById('svcBannerDesc');
  if (desc) {
    desc.textContent = loc.cityName
      ? 'Professional circuit breaker repair and panel services in ' + loc.cityName + ', ' + loc.stateName + '. Same-day dispatch available — call 24/7 for tripping breakers, main breaker replacement & panel upgrades.'
      : 'Your trusted local circuit breaker repair and panel services in ' + loc.stateName + '. Same-day dispatch available — call 24/7 for tripping breakers, main breaker replacement & panel upgrades.';
  }

  document.querySelectorAll('.js-loc-inline').forEach(function (el) { el.textContent = locText; });
  document.querySelectorAll('.js-loc-inline-lower').forEach(function (el) { el.textContent = locLower; });
  document.querySelectorAll('.js-loc-h2').forEach(function (el) { el.textContent = locText; });

  var ctaH2 = document.getElementById('svcCtaH2');
  if (ctaH2) ctaH2.textContent = 'Need Circuit Breaker Repair ' + locText + '?';

  document.querySelectorAll('a.js-svc-link').forEach(function (el) {
    var slug = el.getAttribute('data-slug');
    if (slug) el.setAttribute('href', '/services/' + slug + '/');
  });

  document.title = 'Circuit Breaker & Panel Services ' + locText + ' | {{ site.BRAND }}';

  var bc = document.getElementById('svcBreadcrumb');
  if (bc) {
    var extra = '';
    if (loc.stateSlug) extra += '<span class="bc-sep">›</span><a href="/' + loc.stateSlug + '/">' + loc.stateName + '</a>';
    if (loc.citySlug) extra += '<span class="bc-sep">›</span><a href="/' + loc.stateSlug + '/' + loc.citySlug + '/">' + loc.cityName + '</a>';
    bc.innerHTML = '<i class="ph ph-house" style="font-size:13px"></i><a href="/">Home</a>' + extra + '<span class="bc-sep">›</span><span>Our Services</span>';
  }
})();
</script>
