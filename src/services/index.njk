---
layout: layout.njk
title: "Professional Heating & Furnace Repair Services | HVAC Experts Pros"
description: "Explore our professional heating & HVAC services. Connect with licensed technicians for furnace repairs, emergency service, heat pump care, and seasonal tune-ups."
permalink: "services/index.html"
---

{# ——— Schemas —————————————————————————————————————————————————————————— #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HVACBusiness",
  "name": "{{ site.BRAND }} - Services",
  "url": "{{ site.DOMAIN }}/services/",
  "image": "{{ site.DOMAIN }}/favicon.svg",
  "telephone": "{{ site.PHONE }}",
  "priceRange": "$$"
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.DOMAIN }}/" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "{{ site.DOMAIN }}/services/" }
  ]
}
</script>

{# ── Service Icon Map ──────────────────────────────────────────────────── #}
{% set serviceIcons = {
  'furnace-repair': 'ph-flame',
  'furnace-installation': 'ph-gear',
  'emergency-heating-repair': 'ph-siren',
  'heating-tuneup-maintenance': 'ph-wrench',
  'heat-pump-repair': 'ph-arrows-clockwise',
  'boiler-repair-service': 'ph-drop',
  'thermostat-repair-replacement': 'ph-thermometer',
  'ductless-mini-split': 'ph-wind',
  'air-duct-cleaning-repair': 'ph-fan',
  'indoor-air-quality': 'ph-sparkle',
  'gas-furnace-inspection': 'ph-shield-check',
  'commercial-hvac-services': 'ph-buildings'
} %}

{# ── Breadcrumb ────────────────────────────────────────────────────────── #}
<div class="breadcrumb-bar">
  <div class="container">
    <div class="bc-inner" id="svcBreadcrumb">
      <i class="ph ph-house" style="font-size:13px"></i>
      <a href="/">Home</a>
      <span class="bc-sep">›</span>
      <span>Our Services</span>
    </div>
  </div>
</div>

{# ── Banner ────────────────────────────────────────────────────────────── #}
<div class="rs-banner">
  <div class="banner-bg">
    <img src="/assets/images/global_hero.webp" alt="HVAC Furnace Background" loading="lazy">
  </div>
  <div class="container" style="position:relative;z-index:2">
    <div class="banner-row" style="justify-content:center">
      <div class="banner-content-col">
        <div class="banner-content banner-content-centered">
          <div class="sub-label">
            <span class="live-dot"></span> Professional Heating Services
          </div>
          <h1 class="title">
            Heating &amp; Furnace Services <span id="svcLocationSpan">Nationwide</span>
          </h1>
          <p class="description" id="svcBannerDesc">
            Connect with certified independent HVAC technicians. Call our dispatch team 24/7 for prompt diagnostic support, seasonal maintenance, heat pump repairs, boiler restoration, and emergency heating relief.
          </p>
          <div class="btn-part" style="display:flex; justify-content:center; width:100%; margin:30px auto 0;">
            <a class="readon red-btn" href="{{ site.PHONE_HREF }}">
              <i class="ph ph-phone-call" style="font-size:17px"></i>
              {{ site.PHONE }}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{# ── Services Grid ─────────────────────────────────────────────────────── #}
<div class="rs-services">
  <div class="container">
    <h2>Specialized Heating &amp; Furnace Solutions <span class="js-loc-h2"></span></h2>
    <div class="services-row">
      {% for svc in services %}
      <div class="services-slider">
        <div class="services-item">
          <a href="/services/{{ svc.slug }}/" class="card-link js-svc-link" data-slug="{{ svc.slug }}" aria-label="{{ svc.title }}"></a>
          
          {% if svc.image %}
          <div class="services-card-img">
            <img src="/assets/images/{{ svc.image }}" alt="{{ svc.title }}" loading="lazy">
          </div>
          {% endif %}
          <div class="services-icon-bar">
            <div class="svc-icon">
              <i class="ph {{ serviceIcons[svc.slug] or 'ph-flame' }}"></i>
            </div>
          </div>
          <div class="services-content">
            <h3 class="title">
              <a href="/services/{{ svc.slug }}/" class="js-svc-link" data-slug="{{ svc.slug }}">
                {{ svc.title }}
              </a>
            </h3>
            <p class="description">
              {{ svc.description }}
            </p>
            <div class="services-btn">
              <a href="/services/{{ svc.slug }}/">
                <span class="btn-text">View Service Details</span>
                <span class="arrow-icon">
                  <i class="ph ph-arrow-right" style="font-size:12px"></i>
                </span>
              </a>
            </div>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

{# ── CTA Strip ─────────────────────────────────────────────────────────── #}
<div class="cta-strip">
  <div class="container">
    <h2 id="svcCtaH2">Need Reliable Heating Diagnostics or Repairs?</h2>
    <p>Our licensed independent HVAC contractor network is available 24/7 for prompt scheduling and emergency service.</p>
    <a class="readon red-btn" href="{{ site.PHONE_HREF }}">
      <i class="ph ph-phone-call" style="font-size:18px"></i>
      {{ site.PHONE }} — Call Now
    </a>
  </div>
</div>

{# ── Client-Side Location Detection ───────────────────────────────────── #}
<script>
(function () {
  var userLocStr = localStorage.getItem('userLoc');
  if (!userLocStr) return;

  var loc;
  try {
    loc = JSON.parse(userLocStr);
  } catch(e) {
    return;
  }

  var locText = 'in ' + loc.stateName;
  var locLower = locText.toLowerCase();
  
  if (loc.cityName) {
    locText = 'in ' + loc.cityName + ', ' + loc.stateAbbr;
    locLower = locText.toLowerCase();
  }

  // Update h1 span
  var locSpan = document.getElementById('svcLocationSpan');
  if (locSpan) locSpan.textContent = locText;

  // Update banner description
  var desc = document.getElementById('svcBannerDesc');
  if (desc) {
    desc.textContent = loc.cityName
      ? 'Professional heating and furnace services in ' + loc.cityName + ', ' + loc.stateName + '. Same day service available — call us 24/7 for emergency furnace repair, tune-ups, boiler maintenance & more.'
      : 'Your trusted local furnace and heating services in ' + loc.stateName + '. Same day service available — call us 24/7 for emergency furnace repair, tune-ups, boiler maintenance & more.';
  }

  // Update inline location spans
  document.querySelectorAll('.js-loc-inline').forEach(function (el) { el.textContent = locText; });
  document.querySelectorAll('.js-loc-inline-lower').forEach(function (el) { el.textContent = locLower; });
  document.querySelectorAll('.js-loc-h2').forEach(function (el) { el.textContent = locText; });

  // Update CTA h2
  var ctaH2 = document.getElementById('svcCtaH2');
  if (ctaH2) ctaH2.textContent = 'Need Furnace Repair ' + locText + '?';

  // Update service card links (keep clean URL)
  document.querySelectorAll('a.js-svc-link').forEach(function (el) {
    var slug = el.getAttribute('data-slug');
    if (slug) el.setAttribute('href', '/services/' + slug + '/');
  });

  // Update document title
  document.title = 'Professional Heating & Furnace Services ' + locText + ' | {{ site.BRAND }}';

  // Build breadcrumb
  var bc = document.getElementById('svcBreadcrumb');
  if (bc) {
    var extra = '';
    if (loc.stateSlug) extra += '<span class="bc-sep">›</span><a href="/' + loc.stateSlug + '/">' + loc.stateName + '</a>';
    if (loc.citySlug) extra += '<span class="bc-sep">›</span><a href="/' + loc.stateSlug + '/' + loc.citySlug + '/">' + loc.cityName + '</a>';
    bc.innerHTML = '<i class="ph ph-house" style="font-size:13px"></i><a href="/">Home</a>' + extra + '<span class="bc-sep">›</span><span>Our Services</span>';
  }
})();
</script>
