---
layout: layout.njk
pagination:
  data: services
  size: 1
  alias: service
permalink: "services/{{ service.slug }}/index.html"
eleventyComputed:
  title: "{{ service.title }} Near You | 24/7 Service | Breaker Repair Pros"
  description: "{{ service.title }} near you. Call {{ site.PHONE }} for fast, code-compliant local circuit breaker repair & panel service. 24/7 emergency dispatch available."
---

{# ── Schemas ───────────────────────────────────────────────────────────── #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "{{ service.title }}",
  "serviceType": "{{ service.title }}",
  "description": {{ service.description | dump | safe }},
  "url": "{{ site.DOMAIN }}/services/{{ service.slug }}/",
  "provider": { "@id": "{{ site.DOMAIN }}/#organization" },
  "areaServed": { "@type": "Country", "name": "United States" }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.DOMAIN }}/" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "{{ site.DOMAIN }}/services/" },
    { "@type": "ListItem", "position": 3, "name": "{{ service.title }}", "item": "{{ site.DOMAIN }}/services/{{ service.slug }}/" }
  ]
}
</script>

{# ── Breadcrumb ────────────────────────────────────────────────────────── #}
<div class="breadcrumb-bar">
  <div class="container">
    <div class="bc-inner" id="svcBreadcrumb">
      <i class="ph ph-house" style="font-size:13px"></i>
      <a href="/">Home</a>
      <span class="bc-sep">›</span>
      <a href="/services/">Our Services</a>
      <span class="bc-sep">›</span>
      <span>{{ service.title }}</span>
    </div>
  </div>
</div>

{# ── Banner ────────────────────────────────────────────────────────────── #}
<div class="rs-banner">
  <div class="banner-bg">
    <img src="/assets/images/global_hero.webp" alt="Circuit Breaker Background" loading="lazy">
  </div>
  <div class="container" style="position:relative;z-index:2">
    <div class="banner-row" style="justify-content:center">
      <div class="banner-content-col">
        <div class="banner-content banner-content-centered">
          <div class="sub-label">
            <span class="live-dot"></span> Licensed Electrical Solutions
          </div>
          <h1 class="title">
            {{ service.title }} <span id="svcLocationSpan"></span>
          </h1>
          <p class="description" id="svcBannerDesc">
            {{ service.description }} Connect with verified independent electricians ready to assist with prompt diagnostics and 24/7 emergency dispatch.
          </p>
          <div class="btn-part" style="display:flex; justify-content:center; width:100%; margin:30px auto 0;">
            <a class="readon red-btn" href="{{ site.PHONE_HREF }}">
              <i class="ph ph-phone-call" style="font-size:17px"></i>
              {{ site.PHONE }}
            </a>
          </div>
        </div>
      </div>
      <div class="banner-img-box">
        <img src="/assets/images/{{ service.image or 'global_hero.webp' }}" alt="{{ service.title }} by licensed local circuit breaker electricians near you." width="800" height="600" loading="lazy" decoding="async">
      </div>
    </div>
  </div>
</div>

{# ── Content ───────────────────────────────────────────────────────────── #}
<div class="rs-choose" style="background:var(--gray-bg)">
  <div class="container">
    <div class="choose-grid">
      <div>
        <div class="sec-title4">
          <div class="sub-line"></div>
          <span class="sub-text">
            <i class="ph ph-info" style="font-size:13px"></i>
            About This Service
          </span>
          <h2>Expert {{ service.title }} <span id="svcLocH2">Near You</span></h2>
          <p>
            When you need {{ service.title | lower }} near you,
            {{ site.BRAND }} connects you with vetted, NEC-compliant electricians quickly. Faulty breakers,
            overheated bus bars, and nuisance trips can quickly become serious electrical fire hazards if ignored.
            Explore all of our <a href="/services/" id="svcAllLink" style="color:var(--primary);text-decoration:underline">circuit breaker and panel repair services</a>.
          </p>
          <p>
            Our dispatched electricians carry digital clamp meters, thermal cameras, and UL-listed OEM replacement breakers
            from Square D, Eaton, Siemens, and GE so repairs are completed safely on the first visit with upfront flat-rate pricing.
          </p>
          <div style="margin-top:26px">
            <a class="readon red-btn" href="{{ site.PHONE_HREF }}">
              <i class="ph ph-phone-call" style="font-size:17px"></i>
              {{ site.PHONE }}
            </a>
          </div>
        </div>
      </div>
      <div class="choose-img">
        <img src="/assets/images/{{ service.image or 'global_hero.webp' }}" alt="Professional {{ service.title }} specialists providing safe circuit breaker repairs." width="800" height="600" loading="lazy" decoding="async">
      </div>
    </div>
  </div>
</div>

{# ── CTA Strip ─────────────────────────────────────────────────────────── #}
<div class="cta-strip">
  <div class="container">
    <h2 id="svcCtaH2">Need {{ service.title }} Near You?</h2>
    <p>Don't ignore tripping breakers or buzzing panels. Licensed local electricians are available same-day and 24/7.</p>
    <a class="readon red-btn" href="{{ site.PHONE_HREF }}">
      <i class="ph ph-phone-call" style="font-size:18px"></i>
      {{ site.PHONE }} — Free Estimate
    </a>
  </div>
</div>

{# ── Client-Side Location Detection ───────────────────────────────────── #}
<script>
(function () {
  var SVC_TITLE = {{ service.title | dump | safe }};
  var SVC_DESC  = {{ service.description | dump | safe }};

  var userLocStr = localStorage.getItem('userLoc');
  if (!userLocStr) return;

  var loc;
  try {
    loc = JSON.parse(userLocStr);
  } catch (e) {
    return;
  }

  var locText = 'in ' + loc.stateName;
  if (loc.cityName) {
    locText = 'in ' + loc.cityName + ', ' + loc.stateAbbr;
  }

  var locSpan = document.getElementById('svcLocationSpan');
  if (locSpan) locSpan.textContent = locText;

  var locH2 = document.getElementById('svcLocH2');
  if (locH2) locH2.textContent = locText;

  var desc = document.getElementById('svcBannerDesc');
  if (desc) {
    var newDesc = SVC_DESC.replace(/near you/gi, locText.toLowerCase());
    desc.textContent = newDesc + ' At {{ site.BRAND }}, licensed local electricians are standing by for same-day service and 24/7 emergency dispatch.';
  }

  var ctaH2 = document.getElementById('svcCtaH2');
  if (ctaH2) ctaH2.textContent = 'Need ' + SVC_TITLE + ' ' + locText + '?';

  var allLink = document.getElementById('svcAllLink');
  if (allLink) allLink.setAttribute('href', '/services/');

  var bc = document.getElementById('svcBreadcrumb');
  if (bc) {
    var extra = '';
    if (loc.stateSlug) extra += '<span class="bc-sep">›</span><a href="/' + loc.stateSlug + '/">' + loc.stateName + '</a>';
    if (loc.citySlug) extra += '<span class="bc-sep">›</span><a href="/' + loc.stateSlug + '/' + loc.citySlug + '/">' + loc.cityName + '</a>';
    bc.innerHTML = '<i class="ph ph-house" style="font-size:13px"></i>'
      + '<a href="/">Home</a>' + extra
      + '<span class="bc-sep">›</span><a href="/services/">Our Services</a>'
      + '<span class="bc-sep">›</span><span>' + SVC_TITLE + '</span>';
  }

  document.title = SVC_TITLE + ' ' + locText + ' | 24/7 Service | {{ site.BRAND }}';
})();
</script>
