<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{{ (title | safe) if title else (site.BRAND + " | Reliable Heating & Furnace Repair Services") }}</title>
  <meta name="description" content="{{ (description | safe) if description else 'Professional heating & furnace repair services nationwide. Connect with licensed technicians for 24/7 emergency repairs, seasonal tune-ups, boiler service, and heat pump maintenance.' }}">
  <meta name="keywords" content="HVAC Experts Pros, Furnace Repair, Heating Services, Emergency Heating Repair, Heat Pump Service, Boiler Repair, Heating Contractor">

  {# Canonical & SEO #}
  <link rel="canonical" href="{{ site.DOMAIN }}{{ page.url }}">
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  <meta name="geo.region" content="US">
  <meta name="geo.placename" content="United States">
  <meta name="language" content="English">
  <meta name="revisit-after" content="7 days">
  <meta name="author" content="{{ site.BRAND }}">
  <meta name="rating" content="general">
  <meta name="distribution" content="global">

  {# Favicons #}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="apple-touch-icon" href="/favicon.svg">
  <link rel="manifest" href="/manifest.json">

  {# Open Graph #}
  <meta property="og:type" content="website">
  <meta property="og:locale" content="en_US">
  <meta property="og:site_name" content="{{ site.BRAND }}">
  <meta property="og:title" content="{{ (title | safe) if title else (site.BRAND + ' | Reliable Heating & Furnace Repair Services') }}">
  <meta property="og:description" content="{{ (description | safe) if description else 'Professional heating & furnace repair services nationwide. Connect with licensed technicians for 24/7 emergency repairs, seasonal tune-ups, boiler service, and heat pump maintenance.' }}">
  <meta property="og:url" content="{{ site.DOMAIN }}{{ page.url }}">
  <meta property="og:image" content="{{ site.DOMAIN }}/assets/images/global_hero.webp">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Professional HVAC Furnace Technician - {{ site.BRAND }}">

  {# Twitter Card #}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@hvacexpertspros">
  <meta name="twitter:title" content="{{ (title | safe) if title else (site.BRAND + ' | Reliable Heating & Furnace Repair Services') }}">
  <meta name="twitter:description" content="{{ (description | safe) if description else 'Professional heating & furnace repair services nationwide. Connect with licensed technicians for 24/7 emergency repairs, seasonal tune-ups, boiler service, and heat pump maintenance.' }}">
  <meta name="twitter:image" content="{{ site.DOMAIN }}/assets/images/global_hero.webp">

  {# ── Critical Resource Hints (fire immediately, before HTML parsed) ── #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://unpkg.com" crossorigin>
  <link rel="dns-prefetch" href="https://www.googletagmanager.com">
  <link rel="dns-prefetch" href="https://www.clarity.ms">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&display=swap" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&display=swap"></noscript>
  
  {# Phosphor Icons CSS (100% reliable - Self Hosted) #}
  <link rel="stylesheet" type="text/css" href="/assets/phosphor/regular/style.css">
  
  {# ── Critical Font Preload (Loads instantly with the website) ── #}
  <link rel="preload" href="/assets/phosphor/regular/Phosphor.woff2" as="font" type="font/woff2" crossorigin>

  {# ── Hero Image Preloads — browser starts downloading before CSS/JS ── #}
  <link rel="preload" as="image" href="/assets/images/mobile_hero.webp" type="image/webp" media="(max-width: 767px)" fetchpriority="high">
  <link rel="preload" as="image" href="/assets/images/global_hero.webp" type="image/webp" media="(min-width: 768px)" fetchpriority="high">

  {# ── Inline Critical Stylesheet — zero render blocking ── #}
  <style>{% inlinecss %}</style>

  {# SiteNavigationElement Schema for Google Sitelinks #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "{{ site.DOMAIN }}/#website",
        "url": "{{ site.DOMAIN }}/",
        "name": "{{ site.BRAND }}",
        "alternateName": ["HVAC Experts Pros", "HVAC Experts Pro", "HVAC Experts", "Furnace Repair Pros USA"],
        "description": "24/7 Emergency Furnace Repair & Heating Services Nationwide"
      },
      {
        "@type": "SiteNavigationElement",
        "@id": "{{ site.DOMAIN }}/#navigation",
        "name": ["About Us", "Contact Us", "Services", "Privacy Policy", "Terms & Conditions"],
        "url": [
          "{{ site.DOMAIN }}/about/",
          "{{ site.DOMAIN }}/contact/",
          "{{ site.DOMAIN }}/services/",
          "{{ site.DOMAIN }}/privacy-policy/",
          "{{ site.DOMAIN }}/terms-conditions/"
        ]
      }
    ]
  }
  </script>

  {# JSON-LD Schemas injected from page data #}
  {% if schemas %}
    {% for schema in schemas %}
      <script type="application/ld+json">{{ schema | dump | safe }}</script>
    {% endfor %}
  {% endif %}

  {# ── Analytics (all deferred so they NEVER block page render) ── #}
  {# Microsoft Clarity #}
  <script type="text/javascript">
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "y0029iq9sz");
  </script>
  {# Call Button Tracking for MS Clarity #}
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      var callButtons = document.querySelectorAll('a[href^="tel:"]');
      callButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          if (typeof clarity === 'function') {
            clarity("event", "CallButtonClick");
          }
        });
      });
    });
  </script>

  {# Google Analytics — async #}
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-QEE10Q0T6E"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-QEE10Q0T6E', { 'send_page_view': true });
  </script>
</head>
<body>

