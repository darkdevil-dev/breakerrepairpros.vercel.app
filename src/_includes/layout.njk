<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{{ (title | safe) if title else (site.BRAND + " | 24/7 US Circuit Breaker Repair & Panel Upgrades") }}</title>
  <meta name="description" content="{{ (description | safe) if description else 'Nationwide USA circuit breaker repair referral service. Connect with licensed local electricians for tripping breaker troubleshooting, main breaker swaps, and 200A panel upgrades.' }}">

  {# Canonical, Robots & USA Targeting #}
  {% if noindex %}
  <meta name="robots" content="noindex, nofollow">
  {% else %}
  <link rel="canonical" href="{{ site.DOMAIN }}{{ page.url }}">
  <link rel="alternate" hreflang="en-US" href="{{ site.DOMAIN }}{{ page.url }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.DOMAIN }}{{ page.url }}">
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  {% endif %}
  <meta name="geo.country" content="US">
  <meta name="geo.region" content="{{ geoRegion if geoRegion else 'US' }}">
  <meta name="geo.placename" content="{{ geoPlacename if geoPlacename else 'United States' }}">
  <meta name="author" content="{{ site.BRAND }}">

  {# Favicons #}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="shortcut icon" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/favicon.svg">
  <link rel="manifest" href="/manifest.json">

  {# Open Graph #}
  <meta property="og:type" content="website">
  <meta property="og:locale" content="en_US">
  <meta property="og:site_name" content="{{ site.BRAND }}">
  <meta property="og:title" content="{{ (title | safe) if title else (site.BRAND + ' | 24/7 US Circuit Breaker Repair & Panel Upgrades') }}">
  <meta property="og:description" content="{{ (description | safe) if description else 'Nationwide USA circuit breaker repair referral service. Connect with licensed local electricians for tripping breaker troubleshooting, main breaker swaps, and 200A panel upgrades.' }}">
  <meta property="og:url" content="{{ site.DOMAIN }}{{ page.url }}">
  <meta property="og:image" content="{{ site.DOMAIN }}/assets/images/global_hero.webp">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="800">
  <meta property="og:image:alt" content="Licensed US Electrician Repairing Circuit Breaker Panel - {{ site.BRAND }}">

  {# Twitter Card #}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ (title | safe) if title else (site.BRAND + ' | 24/7 US Circuit Breaker Repair & Panel Upgrades') }}">
  <meta name="twitter:description" content="{{ (description | safe) if description else 'Nationwide USA circuit breaker repair referral service. Connect with licensed local electricians for tripping breaker troubleshooting, main breaker swaps, and 200A panel upgrades.' }}">
  <meta name="twitter:image" content="{{ site.DOMAIN }}/assets/images/global_hero.webp">

  {# ── Critical Resource Hints ── #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://unpkg.com" crossorigin>
  <link rel="dns-prefetch" href="https://www.googletagmanager.com">
  <link rel="dns-prefetch" href="https://www.clarity.ms">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&display=swap" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&display=swap"></noscript>

  {# Phosphor Icons CSS (Self Hosted) #}
  <link rel="stylesheet" type="text/css" href="/assets/phosphor/regular/style.css">

  {# ── Critical Font Preload ── #}
  <link rel="preload" href="/assets/phosphor/regular/Phosphor.woff2" as="font" type="font/woff2" crossorigin>

  {# ── Hero Image Preloads ── #}
  <link rel="preload" as="image" href="/assets/images/mobile_hero.webp" type="image/webp" media="(max-width: 767px)" fetchpriority="high">
  <link rel="preload" as="image" href="/assets/images/global_hero.webp" type="image/webp" media="(min-width: 768px)" fetchpriority="high">

  {# ── Inline Critical Stylesheet ── #}
  <style>{% inlinecss %}</style>

  {# Core Organization, WebSite & SiteNavigationElement Schema #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "{{ site.DOMAIN }}/#website",
        "url": "{{ site.DOMAIN }}/",
        "name": "{{ site.BRAND }}",
        "inLanguage": "en-US",
        "description": "US Circuit Breaker Repair, Tripping Breaker Diagnostics & Electrical Panel Upgrade Referral Network"
      },
      {
        "@type": "Organization",
        "@id": "{{ site.DOMAIN }}/#organization",
        "name": "{{ site.BRAND }}",
        "url": "{{ site.DOMAIN }}/",
        "logo": "{{ site.DOMAIN }}/favicon.svg",
        "email": "{{ site.EMAIL }}",
        "telephone": "{{ site.PHONE }}",
        "areaServed": {
          "@type": "Country",
          "name": "United States"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "{{ site.PHONE }}",
          "contactType": "customer service",
          "areaServed": "US",
          "availableLanguage": "English"
        }
      },
      {
        "@type": "SiteNavigationElement",
        "@id": "{{ site.DOMAIN }}/#navigation",
        "name": ["Home", "Our Services", "About Us", "Contact Us", "Privacy Policy", "Terms of Service"],
        "url": [
          "{{ site.DOMAIN }}/",
          "{{ site.DOMAIN }}/services/",
          "{{ site.DOMAIN }}/about/",
          "{{ site.DOMAIN }}/contact/",
          "{{ site.DOMAIN }}/privacy-policy/",
          "{{ site.DOMAIN }}/terms/"
        ]
      }
    ]
  }
  </script>

  {% if schemas %}
    {% for schema in schemas %}
      <script type="application/ld+json">{{ schema | dump | safe }}</script>
    {% endfor %}
  {% endif %}

  {# ── Analytics (Deferred) ── #}
  <script type="text/javascript">
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "y0029iq9sz");
  </script>
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      var callButtons = document.querySelectorAll('a[href^="tel:"]');
      callButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          if (typeof clarity === 'function') {
            clarity("event", "CallButtonClick");
          }
        });
      });
    });
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-QEE10Q0T6E"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-QEE10Q0T6E', { 'send_page_view': true });
  </script>
</head>
<body>

{% set servicesLink = '/services/' %}

{# ── Header ──────────────────────────────────────────────────────────── #}
<header class="site-header">
  <div class="container">
    <div class="header-inner">
      <a href="/" class="logo">
        <div class="logo-icon">
          <i class="ph ph-lightning" style="font-size:24px;color:#ffffff"></i>
        </div>
        <div class="logo-text">
          <div class="brand" style="color:var(--text-dark)">{{ site.BRAND }}</div>
          <div class="tagline" style="color:var(--text-body)">USA 24/7 Circuit Breaker Service</div>
        </div>
      </a>
      <nav aria-label="Primary Navigation">
        <ul class="nav-links">
          <li><a href="/">Home</a></li>
          <li><a href="{{ servicesLink }}">Our Services</a></li>
          <li><a href="/about/">About Us</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li>
            <a href="{{ site.PHONE_HREF }}" class="header-phone">
              <i class="ph ph-phone-call" style="font-size:15px"></i>
              {{ site.PHONE }}
            </a>
          </li>
        </ul>
        <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Toggle Menu">
          <i class="ph ph-list" style="font-size:28px;color:var(--text-dark)" id="mobileMenuIcon"></i>
        </button>
      </nav>
    </div>
  </div>
  {# Mobile Menu #}
  <div class="mobile-menu" id="mobileMenu">
    <ul class="mobile-nav-links">
      <li><a href="/">Home</a></li>
      <li><a href="{{ servicesLink }}">Our Services</a></li>
      <li><a href="/about/">About Us</a></li>
      <li><a href="/contact/">Contact</a></li>
      <li>
        <a href="{{ site.PHONE_HREF }}" class="mobile-header-phone">
          <i class="ph ph-phone-call" style="font-size:18px"></i>
          {{ site.PHONE }}
        </a>
      </li>
    </ul>
  </div>
</header>

<main>{{ content | safe }}</main>

{# ── Footer ──────────────────────────────────────────────────────────── #}
