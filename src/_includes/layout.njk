  <div class="container">
    <div class="footer-grid">

      <div class="footer-brand">
        <div class="brand-name">
          <i class="ph ph-lightning" style="font-size:20px;color:var(--accent)"></i>
          {{ site.BRAND }}
        </div>
        <p>US-wide referral network connecting homeowners and businesses with state-licensed electricians for circuit breaker repair, tripping breaker diagnostics, main breaker replacements, and 200A panel upgrades across the United States.</p>
      </div>

      <div class="footer-col">
        <h4>Breaker Services</h4>
        <ul>
          <li><a href="/services/circuit-breaker-repair/"><i class="ph ph-lightning"></i>Circuit Breaker Repair</a></li>
          <li><a href="/services/tripping-breaker-troubleshooting/"><i class="ph ph-warning-octagon"></i>Tripping Breakers</a></li>
          <li><a href="/services/main-breaker-replacement/"><i class="ph ph-power"></i>Main Breaker Service</a></li>
          <li><a href="/services/electrical-panel-upgrade/"><i class="ph ph-plugs-connected"></i>Panel Upgrades</a></li>
          <li><a href="/services/emergency-breaker-repair/"><i class="ph ph-siren"></i>Emergency Breaker Fix</a></li>
          <li><a href="{{ servicesLink }}"><i class="ph ph-arrow-right"></i>View All Services</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Quick Links</h4>
        <ul>
          <li><a href="/"><i class="ph ph-house"></i>Home</a></li>
          <li><a href="/about/"><i class="ph ph-info"></i>About Us</a></li>
          <li><a href="/contact/"><i class="ph ph-chat-circle"></i>Contact</a></li>
          <li><a href="{{ servicesLink }}"><i class="ph ph-briefcase"></i>Services</a></li>
          <li><a href="{{ site.PHONE_HREF }}"><i class="ph ph-phone"></i>Call Now</a></li>
          <li><a href="/privacy-policy/"><i class="ph ph-file-text"></i>Privacy Policy</a></li>
          <li><a href="/terms/"><i class="ph ph-file-text"></i>Terms of Service</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Top US Regions</h4>
        <ul>
          <li><a href="/texas/"><i class="ph ph-map-pin"></i>Texas</a></li>
          <li><a href="/california/"><i class="ph ph-map-pin"></i>California</a></li>
          <li><a href="/florida/"><i class="ph ph-map-pin"></i>Florida</a></li>
          <li><a href="/new-york/"><i class="ph ph-map-pin"></i>New York</a></li>
          <li><a href="/illinois/"><i class="ph ph-map-pin"></i>Illinois</a></li>
          <li><a href="/pennsylvania/"><i class="ph ph-map-pin"></i>Pennsylvania</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>US Dispatch Desk</h4>
        <div class="footer-contact-item">
          <span class="ci-icon"><i class="ph ph-phone-call"></i></span>
          <p>
            <a href="{{ site.PHONE_HREF }}">{{ site.PHONE }}</a><br>
            <small style="color:rgba(255,255,255,0.45);font-size:10.5px">USA Same-Day · 24/7 Emergency</small>
          </p>
        </div>
        <div class="footer-contact-item">
          <span class="ci-icon"><i class="ph ph-envelope"></i></span>
          <p><a href="mailto:{{ site.EMAIL }}">{{ site.EMAIL }}</a></p>
        </div>
        <div class="footer-contact-item">
          <span class="ci-icon"><i class="ph ph-clock"></i></span>
          <p>Mon–Sun: Same-Day Dispatch<br>Emergency Line: 24/7 US Coverage</p>
        </div>
      </div>

    </div>

    <div class="footer-disclaimer-box" style="margin: 28px 0 20px; padding: 16px 20px; background: rgba(255,255,255,0.03); border-radius: 8px; border: 1px solid rgba(255,255,255,0.06); text-align: center;">
      <p style="font-size: 11.5px; color: rgba(255,255,255,0.55); line-height: 1.65; margin: 0;">
        <strong>Service &amp; Referral Disclosure:</strong> {{ site.BRAND }} is an independent US lead-connection and referral platform that helps property owners reach locally licensed, independent electrical contractors for circuit breaker repair and panel services. {{ site.BRAND }} does not directly perform electrical work and does not guarantee work performed by third-party contractors. Always verify state licensing and insurance credentials before authorizing service.
      </p>
    </div>

    <div class="footer-bottom">
      <p>© {{ site.YEAR }} {{ site.BRAND }} · United States Coverage. All rights reserved.</p>
      <p>
        <a href="/privacy-policy/">Privacy Policy</a> ·
        <a href="/terms/">Terms of Service</a>
      </p>
    </div>
  </div>
</footer>

{# ── Floating Phone CTA ───────────────────────────────────────────────── #}
<a href="{{ site.PHONE_HREF }}" class="float-phone" aria-label="Call US breaker repair dispatch">
  <i class="ph ph-phone-call" style="font-size:24px;color:#fff"></i>
</a>

{# ── Phosphor Icons CDN ──────────────────────────────────────────────── #}
<script src="https://unpkg.com/@phosphor-icons/web" defer></script>

{# ── Mobile Menu Script ──────────────────────────────────────────────── #}
<script>
(function () {
  var btn = document.getElementById('mobileMenuBtn');
  var menu = document.getElementById('mobileMenu');
  var icon = document.getElementById('mobileMenuIcon');
  if (!btn || !menu) return;
  btn.addEventListener('click', function () {
    var isOpen = menu.classList.toggle('open');
    icon.className = isOpen ? 'ph ph-x' : 'ph ph-list';
    icon.style.cssText = 'font-size:28px;color:var(--text-dark)';
  });
  menu.querySelectorAll('a').forEach(function (a) {
    a.addEventListener('click', function () {
      menu.classList.remove('open');
      icon.className = 'ph ph-list';
      icon.style.cssText = 'font-size:28px;color:var(--text-dark)';
    });
  });
})();
</script>

{# ── FAQ Accordion Script ─────────────────────────────────────────────── #}
<script>
(function () {
  var items = document.querySelectorAll('.acc-item');
  if (!items.length) return;
  items[0].classList.add('open');
  items.forEach(function (item) {
    var btn = item.querySelector('.acc-question');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var wasOpen = item.classList.contains('open');
      items.forEach(function (i) { i.classList.remove('open'); });
      if (!wasOpen) item.classList.add('open');
    });
  });
})();
</script>

</body>
</html>
