<script>
document.getElementById('contactForm').addEventListener('submit', function(e) {
  e.preventDefault();

  const form = this;
  const formData = new FormData(form);
  const data = Object.fromEntries(formData.entries());

  const btn = form.querySelector('button[type="submit"]');
  const btnText = btn.innerHTML;
  if(btn) {
    btn.disabled = true;
    btn.innerHTML = 'Sending...';
  }

  const scriptURL = 'https://script.google.com/macros/s/AKfycbxUz4maH7wogUAAq8AlwGRDPLPR9NNGNq13FuAu7sOdtO5T48ULLRiwKMe5kYcb7Rts/exec';

  fetch(scriptURL, {
    method: 'POST',
    mode: 'no-cors',
    body: JSON.stringify(data),
    headers: {
      'Content-Type': 'text/plain;charset=utf-8',
    }
  }).then(response => {
    showToast('Your circuit breaker service request has been received! Our dispatcher will call you shortly.');
    form.style.display = 'none';
    const successMsg = document.getElementById('formSuccess');
    if(successMsg) successMsg.style.display = 'block';
  }).catch(error => {
    showToast('Something went wrong. Please call our 24/7 line directly.');
    if(btn) {
      btn.disabled = false;
      btn.innerHTML = btnText;
    }
  });
});

function showToast(message) {
  let toast = document.getElementById('leads-toast');
  if (!toast) {
    toast = document.createElement('div');
    toast.id = 'leads-toast';
    toast.style.cssText = 'position:fixed;bottom:30px;right:30px;background:#2563eb;color:#fff;padding:16px 24px;border-radius:8px;box-shadow:0 10px 25px rgba(0,0,0,0.2);font-weight:600;z-index:9999;transition:opacity 0.3s;opacity:0;font-family:system-ui,sans-serif;';
    document.body.appendChild(toast);
  }
  toast.innerText = message;
  toast.style.opacity = '1';

  setTimeout(() => {
    toast.style.opacity = '0';
  }, 4000);
}

document.querySelectorAll('.urgency-pill').forEach(function(label) {
  label.addEventListener('click', function() {
    document.querySelectorAll('.urgency-pill').forEach(l => l.classList.remove('active'));
    this.classList.add('active');
  });
});
</script>
